# ---------- Server ----------
PORT=5000
NODE_ENV=production

# ---------- Database ----------
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<your-cluster>.mongodb.net/online-banking?retryWrites=true&w=majority

# ---------- Auth ----------
JWT_SECRET=<a-long-random-string-at-least-32-characters>
JWT_EXPIRES=30days

# ---------- URLs (no trailing slash) ----------
CLIENT_URL=https://banking-frontend-bay.vercel.app
API_URL=https://<your-live-backend>.onrender.com

# ---------- Cloudinary ----------
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# ---------- Email (Gmail API) ----------
GMAIL_CLIENT_ID=<xxxx>.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=<your-client-secret>
GMAIL_REFRESH_TOKEN=<your-refresh-token>
EMAIL_FROM=<the-same-gmail-you-authorised>@gmail.com
EMAIL_FROM_NAME=SecureTrust Bank